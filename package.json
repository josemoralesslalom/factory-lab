{
  "name": "factory-lab",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "lefthook install",
    "typecheck": "tsc --noEmit && pnpm --filter web typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage && pnpm --filter web test:ci",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm deps:check && pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "deps:check": "pnpm peers check",
    "build": "pnpm --filter web build"
  },
  "keywords": [],
  "author": "",
